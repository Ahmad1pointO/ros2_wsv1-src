<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org" name="abb_scara">

  <!-- ==================================================================== -->
  <!-- 1. XACRO PROPERTIES (Dimensions & Masses)                            -->
  <!-- ==================================================================== -->
  <xacro:property name="base_radius" value="0.11"/>
  <xacro:property name="base_height" value="0.30"/>
  <xacro:property name="base_mass"   value="8.0"/>

  <xacro:property name="link1_length" value="0.35"/>
  <xacro:property name="link1_width"  value="0.10"/>
  <xacro:property name="link1_height" value="0.08"/>
  <xacro:property name="link1_mass"   value="3.0"/>

  <xacro:property name="link2_length" value="0.30"/>
  <xacro:property name="link2_width"  value="0.08"/>
  <xacro:property name="link2_height" value="0.07"/>
  <xacro:property name="link2_mass"   value="2.0"/>

  <xacro:property name="quill_radius" value="0.02"/>
  <xacro:property name="quill_length" value="0.30"/>
  <xacro:property name="quill_mass"   value="0.8"/>

  <xacro:property name="flange_radius" value="0.035"/>
  <xacro:property name="flange_height" value="0.02"/>
  <xacro:property name="flange_mass"   value="0.2"/>

  <!-- ==================================================================== -->
  <!-- 2. XACRO INERTIA MACROS (Rigid-Body Mechanics Formulas)              -->
  <!-- ==================================================================== -->
  <xacro:macro name="cylinder_inertia" params="m r h xyz rpy">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${m}"/>
      <inertia ixx="${(1.0/12.0)*m*(3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(1.0/12.0)*m*(3*r*r + h*h)}" iyz="0.0"
               izz="${0.5*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z xyz rpy">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${m}"/>
      <inertia ixx="${(1.0/12.0)*m*(y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(1.0/12.0)*m*(x*x + z*z)}" iyz="0.0"
               izz="${(1.0/12.0)*m*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================================================================== -->
  <!-- 3. WORLD & BASE PEDESTAL                                             -->
  <!-- ==================================================================== -->
  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <origin xyz="0.0 0.0 ${base_height/2.0}" rpy="0.0 0.0 0.0"/>
      <material name="abb_white"><color rgba="0.95 0.95 0.95 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <origin xyz="0.0 0.0 ${base_height/2.0}" rpy="0.0 0.0 0.0"/>
    </collision>
    <xacro:cylinder_inertia m="${base_mass}" r="${base_radius}" h="${base_height}"
                            xyz="0.0 0.0 ${base_height/2.0}" rpy="0.0 0.0 0.0"/>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- ==================================================================== -->
  <!-- 4. JOINT 1 (REVOLUTE SHOULDER) & LINK 1 (INNER ARM)                  -->
  <!-- ==================================================================== -->
  <link name="link_1">
    <visual>
      <geometry><box size="${link1_length} ${link1_width} ${link1_height}"/></geometry>
      <origin xyz="${link1_length/2.0} 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <material name="abb_white"><color rgba="0.95 0.95 0.95 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${link1_length} ${link1_width} ${link1_height}"/></geometry>
      <origin xyz="${link1_length/2.0} 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </collision>
    <xacro:box_inertia m="${link1_mass}" x="${link1_length}" y="${link1_width}" z="${link1_height}"
                       xyz="${link1_length/2.0} 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0.0 0.0 ${base_height + link1_height/2.0}" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-2.44" upper="2.44" effort="150.0" velocity="3.0"/>
    <dynamics damping="2.0" friction="2.0"/>
  </joint>

  <!-- ==================================================================== -->
  <!-- 5. JOINT 2 (REVOLUTE ELBOW) & LINK 2 (OUTER ARM)                     -->
  <!-- ==================================================================== -->
  <link name="link_2">
    <visual>
      <geometry><box size="${link2_length} ${link2_width} ${link2_height}"/></geometry>
      <origin xyz="${link2_length/2.0} 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <material name="abb_grey"><color rgba="0.3 0.3 0.32 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${link2_length} ${link2_width} ${link2_height}"/></geometry>
      <origin xyz="${link2_length/2.0} 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </collision>
    <xacro:box_inertia m="${link2_mass}" x="${link2_length}" y="${link2_width}" z="${link2_height}"
                       xyz="${link2_length/2.0} 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="${link1_length} 0.0 ${link1_height/2.0 + link2_height/2.0}" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-2.61" upper="2.61" effort="100.0" velocity="3.0"/>
    <dynamics damping="1.5" friction="1.5"/>
  </joint>

  <!-- ==================================================================== -->
  <!-- 6. JOINT 3 (PRISMATIC Z-STROKE) & LINK 3 (VERTICAL QUILL)            -->
  <!-- ==================================================================== -->
  <link name="link_3">
    <visual>
      <geometry><cylinder radius="${quill_radius}" length="${quill_length}"/></geometry>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <material name="steel"><color rgba="0.75 0.75 0.78 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${quill_radius}" length="${quill_length}"/></geometry>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </collision>
    <xacro:cylinder_inertia m="${quill_mass}" r="${quill_radius}" h="${quill_length}"
                            xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </link>

  <joint name="joint_3" type="prismatic">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="${link2_length} 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 0.0 1.0"/>
    <!-- Linear limits in METERS: 0.0m (top) to -0.15m (extended downward) -->
    <limit lower="-0.15" upper="0.0" effort="100.0" velocity="1.0"/>
    <dynamics damping="10.0" friction="15.0"/>
  </joint>

  <!-- ==================================================================== -->
  <!-- 7. JOINT 4 (REVOLUTE WRIST ROLL) & LINK 4 (TOOL FLANGE)              -->
  <!-- ==================================================================== -->
  <link name="link_4">
    <visual>
      <geometry><cylinder radius="${flange_radius}" length="${flange_height}"/></geometry>
      <origin xyz="0.0 0.0 ${-flange_height/2.0}" rpy="0.0 0.0 0.0"/>
      <material name="abb_orange"><color rgba="1.0 0.35 0.0 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${flange_radius}" length="${flange_height}"/></geometry>
      <origin xyz="0.0 0.0 ${-flange_height/2.0}" rpy="0.0 0.0 0.0"/>
    </collision>
    <xacro:cylinder_inertia m="${flange_mass}" r="${flange_radius}" h="${flange_height}"
                            xyz="0.0 0.0 ${-flange_height/2.0}" rpy="0.0 0.0 0.0"/>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.0 0.0 ${-quill_length/2.0}" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-6.28" upper="6.28" effort="50.0" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <!-- ==================================================================== -->
  <!-- 8. ROS2_CONTROL 4-DOF HARDWARE INTERFACE                             -->
  <!-- ==================================================================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">-2.44</param>
        <param name="max">2.44</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">-2.61</param>
        <param name="max">2.61</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">-0.15</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_4">
      <command_interface name="position">
        <param name="min">-6.28</param>
        <param name="max">6.28</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>


   <!-- ==================================================================== -->
  <!-- 9. GAZEBO ROS2_CONTROL BRIDGE PLUGIN                                 -->
  <!-- ==================================================================== -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find scara_robot_description)/config/scara_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>


