<?xml version="1.0"?>
<robot name="three_wheeled_robot">

  <!-- 1. BASE FOOTPRINT -->
  <link name="base_footprint"/>

  <!-- 2. BASE LINK -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.5 0.3 0.15"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <!-- FIX 2: Raised from 0.1 to 0.125 so wheels sit perfectly on top of the ground -->
  <joint name="base_footprint_to_base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.125" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- 3. RIGHT WHEEL -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.15 -0.175 -0.025" rpy="0.0 0.0 0.0"/>
    <!-- FIX 1: Changed from 0.0 0.0 1.0 to 0.0 1.0 0.0 so both wheels roll forward -->
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <!-- 4. LEFT WHEEL -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
      <material name="black"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.15 0.175 -0.025" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <!-- 5. CASTER WHEEL -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.2 0.0 -0.075" rpy="0.0 0.0 0.0"/>
  </joint>

</robot>
