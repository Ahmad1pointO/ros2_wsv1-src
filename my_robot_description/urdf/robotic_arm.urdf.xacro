<?xml version="1.0"?>
<!-- <robot name="robotic_arm"> -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotic_arm1">

  <link name="world"/>

  <!-- 1. ARM BASE LINK -->
  <link name="arm_base">
    <visual>
      <geometry> <cylinder radius="0.1" length="0.2"/> </geometry>
      <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
      <material name="grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
    </visual>
    <collision>
      <geometry> <cylinder radius="0.1" length="0.2"/> </geometry>
      <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0291" ixy="0.0" ixz="0.0" iyy="0.0291" iyz="0.0" izz="0.025"/>
    </inertial>
  </link>

  <joint name="world_to_base_joint" type="fixed">
    <parent link="world"/> <child link="arm_base"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- 2. LINK 1 / LOWER ARM -->
  <link name="link_1">
    <visual>
      <geometry> <box size="0.06 0.06 0.4"/> </geometry>
      <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
      <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>
    </visual>
    <collision>
      <geometry> <box size="0.06 0.06 0.4"/> </geometry>
      <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
      <mass value="2.0"/>
      <inertia ixx="0.0273" ixy="0.0" ixz="0.0" iyy="0.0273" iyz="0.0" izz="0.0012"/>
    </inertial>
  </link>

  <joint name="base_to_link_1_joint" type="revolute">
    <parent link="arm_base"/> <child link="link_1"/>
    <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-3.1416" upper="3.1416" effort="100.0" velocity="1.0"/>
    <!-- ADDED DYNAMICS: Stiff base swivel rotation -->
    <dynamics damping="5.0" friction="10.0"/>
  </joint>

  <!-- 3. LINK 2 / UPPER ARM -->
  <link name="link_2">
    <visual>
      <geometry> <box size="0.3 0.05 0.05"/> </geometry>
      <origin xyz="0.15 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <material name="white"><color rgba="1.0 1.0 1.0 1.0"/></material>
    </visual>
    <collision>
      <geometry> <box size="0.3 0.05 0.05"/> </geometry>
      <origin xyz="0.15 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </collision>
    <inertial>
      <origin xyz="0.15 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="1.5"/>
      <inertia ixx="0.0006" ixy="0.0" ixz="0.0" iyy="0.0116" iyz="0.0" izz="0.0116"/>
    </inertial>
  </link>

  <joint name="link_1_to_link_2_joint" type="revolute">
    <parent link="link_1"/> <child link="link_2"/>
    <origin xyz="0.0 0.0 0.4" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="-1.5708" upper="1.5708" effort="100.0" velocity="1.0"/>
    <!-- ADDED DYNAMICS: Stiff elbow joint to counter gravity -->
    <dynamics damping="1.0" friction="1.0"/>
  </joint>


  </robot>
